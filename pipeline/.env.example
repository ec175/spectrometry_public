# Copy to .env and fill in. Generate secrets with:
#   openssl rand -hex 24        (encryption key)
#   openssl rand -base64 15     (a password)
N8N_BASIC_AUTH_USER=ethan
N8N_BASIC_AUTH_PASSWORD=change-me
# Used to encrypt stored platform credentials. If you lose this, every saved
# credential (YouTube/IG/TikTok tokens) becomes unreadable. Back it up.
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-hex
GENERIC_TIMEZONE=America/Detroit
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
