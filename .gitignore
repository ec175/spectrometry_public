# --- manim output ---
# manim.cfg sets media_dir = ./renders, so everything rendered lands there.
renders/
renders_*/
media/
*.mp4
*.mov
*.mkv
*.webm

# --- python ---
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- secrets: never commit ---
.env
*.env
!.env.example
**/token.txt
**/secrets.json
*.pem
*.key

# --- engine output ---
# Nothing rendered is committed. The reference stills under engines/*/frames/ and
# engines/academia/figures/ are the only images here, hence the narrow allows.
*.wav
*.mp3
*.pdf
out/
scratch/
!engines/*/frames/*.jpg
!engines/academia/figures/*.jpg

engines/*/src/out/
engines/*/src/songs/
engines/*/src/bin/

# --- os / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
